APP_NAME="SIMANTAP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
SIMANTAP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simantap
DB_USERNAME=simantap_app
DB_PASSWORD=

# Database resmi harus tetap terpisah dari database seminar.
SIMANTAP_PRODUCTION_DATABASE=simantap
SIMANTAP_DEMO_MODE=false
SIMANTAP_DEMO_DATABASE=simantapdemo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=simantap_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=simantap_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SIMANTAP_INSTITUTION_NAME="Badan Pusat Statistik"
SIMANTAP_INSTITUTION_SHORT_NAME=BPS
SIMANTAP_UPLOAD_DISK=local
SIMANTAP_DEFAULT_PAGINATION=15
SIMANTAP_MAX_PAGINATION=100
SIMANTAP_MAX_VEHICLE_LOAN_DAYS=3
SIMANTAP_ADMIN_EMPLOYEE_NUMBER="ADMIN001"
SIMANTAP_ADMIN_NAME="Administrator SIMANTAP"
SIMANTAP_ADMIN_EMAIL="admin@simantap.local"
SIMANTAP_ADMIN_PASSWORD="AdminSimantap!2026"
SIMANTAP_ADMIN_WORK_UNIT="BPS"
SIMANTAP_ADMIN_POSITION="Administrator Sistem"

# Isi hanya pada instalasi demo dengan APP_ENV=demo dan DB_DATABASE=simantapdemo.
# Jangan menyalin akun demo ke konfigurasi instalasi resmi.
SIMANTAP_DEMO_ADMIN_EMPLOYEE_NUMBER="DEMO-ADMIN-001"
SIMANTAP_DEMO_ADMIN_NAME="Administrator Demo"
SIMANTAP_DEMO_ADMIN_EMAIL=
SIMANTAP_DEMO_ADMIN_PASSWORD=
SIMANTAP_DEMO_ADMIN_WORK_UNIT="BPS Kabupaten Jombang - Demo"
SIMANTAP_DEMO_ADMIN_POSITION="Administrator Demo"
SIMANTAP_DEMO_EMPLOYEE_EMPLOYEE_NUMBER="DEMO-PEGAWAI-001"
SIMANTAP_DEMO_EMPLOYEE_NAME="Pegawai Demo"
SIMANTAP_DEMO_EMPLOYEE_EMAIL=
SIMANTAP_DEMO_EMPLOYEE_PASSWORD=
SIMANTAP_DEMO_EMPLOYEE_WORK_UNIT="BPS Kabupaten Jombang - Demo"
SIMANTAP_DEMO_EMPLOYEE_POSITION="Pegawai Demo"
SIMANTAP_SIGNATORY_ADMINISTRATOR="SIM-JBG-017"
SIMANTAP_SIGNATORY_KASUBBAG="SIM-JBG-020"
# Overrides khusus kartu stok (opsional; default memakai dua nilai di atas)
# SIMANTAP_SIGNATORY_STOCK_CARD_MANAGER="SIM-JBG-017"
# SIMANTAP_SIGNATORY_STOCK_CARD_KASUBBAG="SIM-JBG-020"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
